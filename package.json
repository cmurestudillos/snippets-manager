{
  "name": "snippets-manager",
  "version": "2.1.0",
  "description": "Gestor de snippets de código para escritorio (Electron): local o con API propia",
  "main": "src/main.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "package:mac": "electron-builder build --mac",
    "package:win": "electron-builder build --windows",
    "package:linux": "electron-builder build --linux"
  },
  "keywords": [
    "electron",
    "snippets",
    "code",
    "manager"
  ],
  "author": "Carlos Mur",
  "license": "MIT",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "axios": "^1.18.1",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.cmurestudillos.snippetsmanager",
    "productName": "Snippets Manager Pro",
    "directories": {
      "output": "release/"
    },
    "files": [
      "**/*",
      "!docs{,/**/*}",
      "!.github{,/**/*}",
      "!.vscode{,/**/*}",
      "!release{,/**/*}",
      "!README.md",
      "!eslint.config.js",
      "!pnpm-workspace.yaml",
      "!pnpm-lock.yaml",
      "!.npmrc",
      "!.prettierrc",
      "!.prettierignore",
      "!.gitattributes"
    ],
    "publish": {
      "provider": "github",
      "owner": "cmurestudillos",
      "repo": "snippets-manager",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "src/assets/icons/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "src/assets/icons/icon.png",
      "category": "Development",
      "target": "AppImage"
    }
  }
}
