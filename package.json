{
  "name": "snippets-manager",
  "version": "2.0.0",
  "description": "Gestor de snippets de código con Electron",
  "main": "src/main.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "package:mac": "electron-builder build --mac",
    "package:win": "electron-builder build --windows",
    "package:linux": "electron-builder build --linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "keywords": [
    "electron",
    "snippets",
    "code",
    "manager"
  ],
  "author": "Carlos Mur",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^14.0.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.cmurestudillos.snippetsmanager",
    "productName": "Snippets Manager",
    "directories": {
      "output": "release/"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/icons/icon.icns"
    },
    "win": {
      "icon": "src/assets/icons/icon.ico"
    },
    "linux": {
      "icon": "src/assets/icons/icon.png",
      "category": "Development"
    }
  }
}
